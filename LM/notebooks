      "cell_type": "code",
      "source": [
        "# Aplicar SMOTE apenas no conjunto de treino\n",
        "smote = SMOTE(random_state=42)\n",
        "X_train_smote, y_train_smote = smote.fit_resample(X_train, y_train)\n",
        "\n",
        "# Verificar a nova distribuição das classes no conjunto de treino\n",
        "print(\"Distribuição das classes após SMOTE:\")\n",
        "print(pd.Series(y_train_smote).value_counts())\n",
        "\n",
        "# Treinar o modelo Random Forest com os dados balanceados pelo SMOTE\n",
        "model_smote = RandomForestClassifier(n_estimators=100, random_state=42)\n",
        "model_smote.fit(X_train_smote, y_train_smote)\n",
        "\n",
        "# Previsões com o modelo treinado com SMOTE\n",
        "y_pred_smote = model_smote.predict(X_test)\n",
        "\n",
        "# Matriz de Confusão com SMOTE\n",
        "conf_matrix_smote = confusion_matrix(y_test, y_pred_smote)\n",
        "print(\"\\nMatriz de Confusão com SMOTE:\")\n",
        "print(conf_matrix_smote)\n",
        "\n",
        "# Plotar a matriz de confusão com SMOTE\n",
        "plt.figure(figsize=(8, 6))\n",
        "sns.heatmap(conf_matrix_smote, annot=True, fmt='d', cmap='Blues',\n",
        "            xticklabels=['Não Popular', 'Popular'],\n",
        "            yticklabels=['Não Popular', 'Popular'])\n",
        "plt.xlabel('Previsto')\n",
        "plt.ylabel('Verdadeiro')\n",
        "plt.title('Matriz de Confusão - Random Forest com SMOTE')\n",
        "plt.show()\n",
        "\n",
        "# Relatório de classificação com SMOTE\n",
        "print(\"\\nMétricas de Classificação com SMOTE:\")\n",
        "print(classification_report(y_test, y_pred_smote, target_names=['Não Popular', 'Popular']))\n",
        "\n",
        "# Importância das variáveis com o modelo SMOTE\n",
        "importancias_smote = model_smote.feature_importances_\n",
        "\n",
        "# Ordenar por importância\n",
        "indices_ordenados_smote = np.argsort(importancias_smote)[::-1]\n",
        "plt.figure(figsize=(12, 6))\n",
        "sns.barplot(x=importancias_smote[indices_ordenados_smote], y=nomes_variaveis[indices_ordenados_smote], palette='viridis')\n",
        "plt.title('Importância das Variáveis - Random Forest com SMOTE')\n",
        "plt.xlabel('Importância')\n",
        "plt.ylabel('Variável')\n",
        "plt.tight_layout()\n",
